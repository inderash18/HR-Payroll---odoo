{
  "name": "odoo-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "node server/scripts/ensure-env.js",
    "predev": "node server/scripts/ensure-env.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "echo \"Server ready\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
