datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  ADMIN
  HR_MANAGER
  PAYROLL_MANAGER
  HR_PAYROLL_MANAGER
  HR_PAYROLL_USER
  FINANCE_MANAGER
  DEPARTMENT_MANAGER
  EMPLOYEE
  AUDITOR
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PayrunStatus {
  DRAFT
  COMPUTING
  COMPUTED
  WARNINGS_FOUND
  VALIDATED
  PAID
  CANCELLED
}

enum LeaveStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AllocationStatus {
  DRAFT
  PENDING
  APPROVED
  REFUSED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  EARLY_LEAVE
  ON_LEAVE
  OVERTIME
  MISSING_CHECKOUT
  HOLIDAY
}

enum RuleCategoryType {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  CONTRIBUTION
  NET
  EARNING
  TAX
  EMPLOYER_CONTRIBUTION
}

enum AmountType {
  FIXED
  PERCENTAGE
  FORMULA
  CONTRACT_BASE
  CODE_FORMULA
}

enum WarningSeverity {
  INFO
  WARNING
  BLOCKING
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  currency         String            @default("USD")
  timezone         String            @default("UTC")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  legalEntities    LegalEntity[]
  departments      Department[]
  jobPositions     JobPosition[]
  workingSchedules WorkingSchedule[]
  employees        Employee[]
  contracts        Contract[]
  leaveTypes       LeaveType[]
  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]
  attendances      Attendance[]
  salaryStructures SalaryStructure[]
  salaryRules      SalaryRule[]
  payruns          Payrun[]
  payslips         Payslip[]
  emailDeliveries  EmailDeliveryRecord[]
  users            User[]
  auditLogs        AuditLog[]
  outboxEvents     OutboxEvent[]
  idempotencyKeys  IdempotencyKey[]
  projects         Project[]
  announcements    Announcement[]
  notifications    Notification[]

  @@map("organizations")
}

model LegalEntity {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  name            String
  code            String
  registrationNum String?      @map("registration_num")
  taxId           String?      @map("tax_id")
  country         String       @default("US")
  currency        String       @default("USD")
  address         Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  employees       Employee[]
  payruns         Payrun[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("legal_entities")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  parentId       String?      @map("parent_id")
  managerId      String?      @map("manager_id")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[] @relation("DepartmentHierarchy")
  manager        User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees      Employee[]
  jobPositions   JobPosition[]
  projects       Project[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model JobPosition {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  departmentId   String?      @map("department_id")
  title          String
  code           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("job_positions")
}

model WorkingSchedule {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  name           String
  type           String                @default("STANDARD_40H")
  timezone       String                @default("UTC")
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          WorkingScheduleLine[]
  employees      Employee[]
  contracts      Contract[]

  @@index([organizationId])
  @@map("working_schedules")
}

model WorkingScheduleLine {
  id           String          @id @default(uuid())
  scheduleId   String          @map("schedule_id")
  dayOfWeek    Int             @map("day_of_week") // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String          @map("start_time") // e.g. "09:00"
  endTime      String          @map("end_time")   // e.g. "17:00"
  breakMinutes Int             @default(60) @map("break_minutes")

  schedule     WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, dayOfWeek])
  @@map("working_schedule_lines")
}

model Employee {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  legalEntityId     String?           @map("legal_entity_id")
  userId            String?           @unique @map("user_id")
  departmentId      String?           @map("department_id")
  jobPositionId     String?           @map("job_position_id")
  workingScheduleId String?           @map("working_schedule_id")
  employeeNum       String            @map("employee_num")
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  workEmail         String            @map("work_email")
  personalEmail     String?           @map("personal_email")
  phone             String?
  bankName          String?           @map("bank_name")
  bankAccountMasked String?           @map("bank_account_masked")
  taxId             String?           @map("tax_id")
  joiningDate       DateTime          @default(now()) @map("joining_date")
  terminationDate   DateTime?         @map("termination_date")
  workMode          String            @default("HYBRID") @map("work_mode")
  location          String            @default("Coimbatore") @map("location")
  employmentType    String            @default("FULL_TIME") @map("employment_type")
  skills            Json?             @map("skills")
  probationEndDate  DateTime?         @map("probation_end_date")
  noticePeriodDays  Int               @default(60) @map("notice_period_days")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity       LegalEntity?      @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobPosition       JobPosition?      @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  workingSchedule   WorkingSchedule?  @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  contracts         Contract[]
  leaveAllocations  LeaveAllocation[]
  leaveRequests     LeaveRequest[]
  attendances       Attendance[]
  payrunEmployees   PayrunEmployee[]
  payslips          Payslip[]
  payrollWarnings   PayrollWarning[]
  projectMemberships ProjectMember[]

  @@unique([organizationId, employeeNum])
  @@unique([organizationId, workEmail])
  @@index([organizationId])
  @@index([departmentId])
  @@map("employees")
}

model Contract {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  employeeId        String           @map("employee_id")
  structureId       String           @map("structure_id")
  workingScheduleId String?          @map("working_schedule_id")
  name              String
  wage              Decimal          @db.Decimal(15, 2)
  wagePeriod        String           @default("MONTHLY") @map("wage_period")
  startDate         DateTime         @map("start_date")
  endDate           DateTime?        @map("end_date")
  status            ContractStatus   @default(DRAFT)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure         SalaryStructure  @relation(fields: [structureId], references: [id], onDelete: Restrict)
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  payslips          Payslip[]

  @@index([organizationId, employeeId, status])
  @@index([startDate, endDate])
  @@map("contracts")
}

model LeaveType {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  name               String
  code               String
  isPaid             Boolean           @default(true) @map("is_paid")
  requiresAllocation Boolean           @default(true) @map("requires_allocation")
  approvalRequired   Boolean           @default(true) @map("approval_required")
  daysAllowed        Int               @default(20) @map("days_allowed")
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveAllocations   LeaveAllocation[]
  leaveRequests      LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

model LeaveAllocation {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  employeeId      String           @map("employee_id")
  leaveTypeId     String           @map("leave_type_id")
  allocatedAmount Decimal          @db.Decimal(5, 2) @map("allocated_amount")
  consumedAmount  Decimal          @default(0) @db.Decimal(5, 2) @map("consumed_amount")
  validFrom       DateTime         @map("valid_from")
  validUntil      DateTime         @map("valid_until")
  status          AllocationStatus @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType        @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, leaveTypeId])
  @@map("leave_allocations")
}

model LeaveRequest {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  employeeId     String       @map("employee_id")
  leaveTypeId    String       @map("leave_type_id")
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  numberOfDays   Decimal      @db.Decimal(5, 2) @map("number_of_days")
  reason         String?
  status         LeaveStatus  @default(PENDING_APPROVAL)
  approvedById   String?      @map("approved_by_id")
  approvedAt     DateTime?    @map("approved_at")
  refusedById    String?      @map("refused_by_id")
  refusedAt      DateTime?    @map("refused_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvedBy     User?        @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  refusedBy      User?        @relation("LeaveRefuser", fields: [refusedById], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model Attendance {
  id                 String           @id @default(uuid())
  organizationId     String           @map("organization_id")
  employeeId         String           @map("employee_id")
  date               DateTime         @db.Date
  checkIn            DateTime         @map("check_in")
  checkOut           DateTime?        @map("check_out")
  workedHours        Decimal?         @db.Decimal(5, 2) @map("worked_hours")
  lateMinutes        Int              @default(0) @map("late_minutes")
  overtimeMinutes    Int              @default(0) @map("overtime_minutes")
  status             AttendanceStatus @default(PRESENT)
  manuallyModified   Boolean          @default(false) @map("manually_modified")
  modifiedById       String?          @map("modified_by_id")
  modificationReason String?          @map("modification_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@map("attendances")
}

model SalaryStructure {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          SalaryRule[]
  contracts      Contract[]
  payruns        Payrun[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("salary_structures")
}

model SalaryRule {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  structureId       String           @map("structure_id")
  name              String
  code              String
  category          RuleCategoryType
  sequence          Int              @default(10)
  amountType        AmountType       @default(FIXED) @map("amount_type")
  amountFixed       Decimal?         @db.Decimal(15, 2) @map("amount_fixed")
  amountPercentage  Decimal?         @db.Decimal(5, 2) @map("amount_percentage")
  percentageBasedOn String?          @map("percentage_based_on")
  codeFormula       String?          @map("code_formula")
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  structure         SalaryStructure  @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([structureId, code])
  @@index([organizationId, structureId])
  @@map("salary_rules")
}

model Payrun {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  legalEntityId     String?          @map("legal_entity_id")
  salaryStructureId String?          @map("salary_structure_id")
  name              String
  startDate         DateTime         @map("start_date")
  endDate           DateTime         @map("end_date")
  status            PayrunStatus     @default(DRAFT)
  totalGross        Decimal          @default(0) @db.Decimal(15, 2) @map("total_gross")
  totalNet          Decimal          @default(0) @db.Decimal(15, 2) @map("total_net")
  computedAt        DateTime?        @map("computed_at")
  validatedAt       DateTime?        @map("validated_at")
  validatedById     String?          @map("validated_by_id")
  paidAt            DateTime?        @map("paid_at")
  paidById          String?          @map("paid_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity       LegalEntity?     @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  payrunEmployees   PayrunEmployee[]
  payslips          Payslip[]
  warnings          PayrollWarning[]

  @@index([organizationId, status])
  @@index([startDate, endDate])
  @@map("payruns")
}

model PayrunEmployee {
  id         String   @id @default(uuid())
  payrunId   String   @map("payrun_id")
  employeeId String   @map("employee_id")
  contractId String   @map("contract_id")
  createdAt  DateTime @default(now()) @map("created_at")

  payrun     Payrun   @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrunId, employeeId])
  @@map("payrun_employees")
}

model Payslip {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  payrunId          String           @map("payrun_id")
  employeeId        String           @map("employee_id")
  contractId        String           @map("contract_id")
  salaryStructureId String?          @map("salary_structure_id")
  periodStart       DateTime         @map("period_start")
  periodEnd         DateTime         @map("period_end")
  scheduledDays     Decimal          @default(0) @db.Decimal(5, 2) @map("scheduled_days")
  workedDays        Decimal          @default(0) @db.Decimal(5, 2) @map("worked_days")
  paidLeaveDays     Decimal          @default(0) @db.Decimal(5, 2) @map("paid_leave_days")
  unpaidLeaveDays   Decimal          @default(0) @db.Decimal(5, 2) @map("unpaid_leave_days")
  grossSalary       Decimal          @db.Decimal(15, 2) @map("gross_salary")
  deductionAmount   Decimal          @default(0) @db.Decimal(15, 2) @map("deduction_amount")
  netSalary         Decimal          @db.Decimal(15, 2) @map("net_salary")
  currency          String           @default("USD")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrun            Payrun           @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract          Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  lines             PayslipLine[]
  warnings          PayrollWarning[]
  emailDeliveries   EmailDeliveryRecord[]

  @@unique([payrunId, employeeId])
  @@index([organizationId, payrunId])
  @@index([organizationId, employeeId])
  @@map("payslips")
}

model PayslipLine {
  id         String           @id @default(uuid())
  payslipId  String           @map("payslip_id")
  category   RuleCategoryType
  code       String
  name       String
  sequence   Int              @default(10)
  amount     Decimal          @db.Decimal(15, 2)
  baseAmount Decimal?         @db.Decimal(15, 2) @map("base_amount")
  rate       Decimal?         @db.Decimal(5, 2)
  createdAt  DateTime         @default(now()) @map("created_at")

  payslip    Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("payslip_lines")
}

model PayrollWarning {
  id         String          @id @default(uuid())
  payrunId   String          @map("payrun_id")
  payslipId  String?         @map("payslip_id")
  employeeId String?         @map("employee_id")
  code       String
  message    String
  severity   WarningSeverity @default(WARNING)
  createdAt  DateTime        @default(now()) @map("created_at")

  payrun     Payrun          @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  payslip    Payslip?        @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  employee   Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([payrunId, severity])
  @@map("payroll_warnings")
}

model EmailDeliveryRecord {
  id            String              @id @default(uuid())
  organizationId String             @map("organization_id")
  payslipId     String              @map("payslip_id")
  recipient     String
  status        EmailDeliveryStatus @default(PENDING)
  sentAt        DateTime?           @map("sent_at")
  failureReason String?             @map("failure_reason")
  attemptCount  Int                 @default(0) @map("attempt_count")
  createdAt     DateTime            @default(now()) @map("created_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslip       Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("email_delivery_records")
}

model User {
  id                  String               @id @default(uuid())
  organizationId      String               @map("organization_id")
  legalEntityId       String?              @map("legal_entity_id")
  email               String
  passwordHash        String               @map("password_hash")
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  role                Role                 @default(EMPLOYEE)
  isActive            Boolean              @default(true) @map("is_active")
  isEmailVerified     Boolean              @default(false) @map("is_email_verified")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?            @map("lockout_until")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity         LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  employee            Employee?
  managedDepartments  Department[]         @relation("DepartmentManager")
  managedProjects     Project[]            @relation("ProjectManager")
  approvedLeaves      LeaveRequest[]       @relation("LeaveApprover")
  refusedLeaves       LeaveRequest[]       @relation("LeaveRefuser")
  authoredAnnouncements Announcement[]     @relation("AnnouncementAuthor")
  announcementReads   AnnouncementRead[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  tokenHash          String       @unique @map("token_hash")
  expiresAt          DateTime     @map("expires_at")
  revokedAt          DateTime?    @map("revoked_at")
  replacedByTokenHash String?     @map("replaced_by_token_hash")
  ipAddress          String?      @map("ip_address")
  userAgent          String?      @map("user_agent")
  createdAt          DateTime     @default(now()) @map("created_at")

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String?      @map("user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  oldValues      Json?        @map("old_values")
  newValues      Json?        @map("new_values")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  lastError      String?      @map("last_error")
  processedAt    DateTime?    @map("processed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  key             String       @id
  organizationId  String       @map("organization_id")
  userId          String?      @map("user_id")
  requestPath     String       @map("request_path")
  requestBodyHash String       @map("request_body_hash")
  statusCode      Int?         @map("status_code")
  responseBody    Json?        @map("response_body")
  lockedAt        DateTime     @default(now()) @map("locked_at")
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@map("idempotency_keys")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Project {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  departmentId   String?         @map("department_id")
  managerId      String?         @map("manager_id")
  name           String
  code           String
  type           String          @default("CLIENT_PROJECT") // CLIENT_PROJECT, INTERNAL_PRODUCT, INTERNAL_SAAS
  status         String          @default("ACTIVE") // ACTIVE, PLANNING, ON_HOLD, COMPLETED
  techStack      Json?           @map("tech_stack")
  startDate      DateTime        @default(now()) @map("start_date")
  endDate        DateTime?       @map("end_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager        User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members        ProjectMember[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  employeeId    String   @map("employee_id")
  roleInProject String   @default("MEMBER") @map("role_in_project")
  allocationPct Int      @default(100) @map("allocation_pct")
  joinedAt      DateTime @default(now()) @map("joined_at")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@map("project_members")
}

model Announcement {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  authorId       String?            @map("author_id")
  title          String
  category       String             @default("GENERAL") // GENERAL, ENGINEERING, RELEASE, POLICY, CELEBRATION, TOWN_HALL
  priority       String             @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  content        String             @db.Text
  targetDept     String?            @map("target_dept")
  publishedAt    DateTime           @default(now()) @map("published_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads          AnnouncementRead[]

  @@index([organizationId, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at")

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  type           String       @default("INFO") // LEAVE, PAYROLL, ATTENDANCE, PROFILE, APPROVAL, SYSTEM
  title          String
  message        String
  link           String?
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}


