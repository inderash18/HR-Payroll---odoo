{
  "name": "peoplepay360-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ensure-env": "node scripts/ensure-env.js",
    "dev": "node scripts/ensure-env.js && nodemon src/server.js",
    "start": "node scripts/ensure-env.js && node src/server.js",
    "prisma:generate": "node scripts/ensure-env.js && prisma generate",
    "prisma:migrate": "node scripts/ensure-env.js && prisma migrate dev",
    "prisma:seed": "node scripts/ensure-env.js && node prisma/seed.js",
    "seed": "node scripts/ensure-env.js && node prisma/seed.js",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "puppeteer": "^24.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.8"
  }
}
